# Langfuse セルフホスト用の環境変数のテンプレート。
# 実際の値は `.env` にコピーして埋める（.env はコミットしない）。
#
# 生成例:
#   ENCRYPTION_KEY:   openssl rand -hex 32
#   SALT / SECRET 類: openssl rand -hex 16
#   各パスワード:     openssl rand -hex 12

# web は http://localhost:3001 でアクセス（AudienceRoom frontend が 3000 のため）
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=__generate__
SALT=__generate__
ENCRYPTION_KEY=__generate_hex_32__

POSTGRES_PASSWORD=__generate__
# DATABASE_URL は POSTGRES_PASSWORD と必ず一致させる（既定値は postgres:postgres 固定でズレるため）
DATABASE_URL=postgresql://postgres:__same_as_POSTGRES_PASSWORD__@postgres:5432/postgres
CLICKHOUSE_PASSWORD=__generate__
REDIS_AUTH=__generate__
MINIO_ROOT_PASSWORD=__generate__
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=__same_as_MINIO_ROOT_PASSWORD__
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=__same_as_MINIO_ROOT_PASSWORD__
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=__same_as_MINIO_ROOT_PASSWORD__

# 初回起動時に組織/プロジェクト/ユーザ/APIキーを自動作成（UI 手作業を省く）
LANGFUSE_INIT_ORG_ID=audienceroom
LANGFUSE_INIT_ORG_NAME=AudienceRoom
LANGFUSE_INIT_PROJECT_ID=topic-extraction
LANGFUSE_INIT_PROJECT_NAME=topic-extraction
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local-audienceroom
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local-audienceroom
LANGFUSE_INIT_USER_EMAIL=dev@audienceroom.local
LANGFUSE_INIT_USER_NAME=Dev
LANGFUSE_INIT_USER_PASSWORD=__generate__
